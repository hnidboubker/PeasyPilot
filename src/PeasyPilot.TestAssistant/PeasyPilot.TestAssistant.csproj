<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NuGet package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>PeasyPilot.TestAssistant</PackageId>
    <Version>0.1.3</Version>
    <PackageIcon>Logo.png</PackageIcon>
    <Authors>NID BOUBKER Houssine</Authors>
    <Description>Test suite generation assistance for PeasyPilot â€” reflection-based nominal/edge-case analysis and rendering.</Description>
    <PackageTags>dotnet;framework;testing;test-generation;suggestions;xunit;nunit;tunit</PackageTags>
    <RepositoryUrl>https://github.com/hnidboubker/PeasyPilot</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PeasyPilot.Core/PeasyPilot.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../assets/logos/Logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>