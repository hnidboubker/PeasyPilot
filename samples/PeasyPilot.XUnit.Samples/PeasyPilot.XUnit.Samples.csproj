<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PeasyPilot.Core\PeasyPilot.Core.csproj" />
    <ProjectReference Include="..\..\src\PeasyPilot.XUnit\PeasyPilot.XUnit.csproj" />
    <ProjectReference Include="..\..\src\PeasyPilot.Integration\PeasyPilot.Integration.csproj" />
    <ProjectReference Include="..\..\src\PeasyPilot.BDD\PeasyPilot.BDD.csproj" />
    <ProjectReference Include="..\..\src\PeasyPilot.Bogus\PeasyPilot.Bogus.csproj" />
    <ProjectReference Include="..\..\src\PeasyPilot.Moq\PeasyPilot.Moq.csproj" />
    <ProjectReference Include="..\..\src\PeasyPilot.Unit\PeasyPilot.Unit.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- CS1591: missing XML docs; xUnit1051: CancellationToken advice (TestContext) not used in test/sample code -->
    <NoWarn>$(NoWarn);CS1591;xUnit1051</NoWarn>
  </PropertyGroup>
</Project>
